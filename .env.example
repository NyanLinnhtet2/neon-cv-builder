# Copy this file's variable names into Vercel → Project → Settings →
# Environment Variables. Never commit a real .env file, and never put
# these values in any frontend (index.html / css / js) file.

# Required — lets the Feedback form deliver messages to your Telegram.
# See README.md "Setting up the Telegram bot" for how to get these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — enables anonymous analytics (visitors, CVs created, PDF
# downloads, feedback count) and basic feedback rate limiting. Leave
# blank to disable both; the app works fine without them.
# See README.md "Setting up analytics storage" for how to get these.
# The code accepts either naming convention below — use whichever one
# your Upstash/Vercel setup actually generated (check Vercel →
# Settings → Environment Variables to see which you have).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# -- OR, if connected via Vercel's Upstash Marketplace integration with
#    a custom prefix (e.g. "UPSTASH_REDIS") --
# UPSTASH_REDIS_KV_REST_API_URL=
# UPSTASH_REDIS_KV_REST_API_TOKEN=

# Optional — required only if UPSTASH_* above is set. Choose any long
# random string yourself; it's the password for the /?admin=1
# analytics dashboard.
ADMIN_SECRET=
